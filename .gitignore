# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Environment variables / secrets
.env
*.local

# Data & vector store (large, regenerable — don't commit)
data/raw/*
data/processed/*
data/vector_store/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/vector_store/.gitkeep

# Model weights / caches
*.bin
*.gguf
.ollama/
models/

# Jupyter
.ipynb_checkpoints/
notebooks/*.ipynb
!notebooks/.gitkeep

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# OS
.DS_Store
Thumbs.db

# Build artifacts
build/
dist/
*.egg-info/
.coverage
htmlcov/
