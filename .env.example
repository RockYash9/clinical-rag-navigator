# Copy this file to .env and fill in local values. Never commit the real .env.

# LLM (local via Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Embedding model (HuggingFace model id, downloaded locally — free)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector store
VECTOR_STORE_PATH=data/vector_store/index.faiss

# API
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
